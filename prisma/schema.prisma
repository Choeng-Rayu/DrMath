generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContentType {
  TEXT
  RICH_TEXT
  LINK
  IMAGE
  BOOLEAN
  JSON
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteContent {
  id        String      @id @default(cuid())
  key       String      @unique
  section   String
  value     String      @db.Text
  draftValue String?    @db.Text
  type      ContentType @default(TEXT)
  visible   Boolean     @default(true)
  draftVisible Boolean?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([section])
}

model Settings {
  id               String   @id @default("site-settings")
  phones           String   @default("[]") @db.Text
  telegramUrl      String?
  facebookUrl      String?
  tiktokUrl        String?
  instagramUrl     String?
  logoDriveUrl     String?  @db.Text
  logoDriveId      String?
  logoRenderUrl    String?  @db.Text
  logoAlt          String?  @default("DR.MATHS")
  addressKh        String?  @db.Text
  hoursKh          String?  @db.Text
  footerTextKh     String?  @db.Text
  seoTitleKh       String?  @db.Text
  seoDescriptionKh String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MediaAsset {
  id              String   @id @default(cuid())
  driveUrl        String   @unique @db.Text
  driveFileId     String
  renderUrl       String   @db.Text
  altKh           String?
  category        String?
  validationState String   @default("valid")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Video {
  id         String   @id @default(cuid())
  titleKh    String
  youtubeUrl String   @db.Text
  youtubeId  String   @unique
  thumbUrl   String   @db.Text
  seriesKh   String?
  featured   Boolean  @default(false)
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, order])
  @@index([featured])
}

model Subject {
  id            String   @id @default(cuid())
  icon          String   @default("∑")
  nameKh        String
  descriptionKh String   @db.Text
  mediaId       String?
  order         Int      @default(0)
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visible, order])
}

model Testimonial {
  id        String   @id @default(cuid())
  nameKh    String
  roleKh    String?
  quoteKh   String   @db.Text
  rating    Int      @default(5)
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
}

model Exercise {
  id            String   @id @default(cuid())
  titleKh       String
  descriptionKh String?  @db.Text
  subjectKh     String?
  gradeKh       String?
  driveUrl      String   @db.Text
  driveFileId   String
  renderUrl     String   @db.Text
  solutionUrl   String?  @db.Text
  featured      Boolean  @default(false)
  order         Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, order])
  @@index([featured])
  @@index([subjectKh])
}

model Post {
  id          String   @id @default(cuid())
  titleKh     String
  badgeKh     String?  @default("ដំណឹងជ្រើសរើស")
  contentKh   String   @db.Text
  driveUrl    String?  @db.Text
  driveFileId String?
  renderUrl   String?  @db.Text
  actionUrl   String?  @db.Text
  actionLabel String?  @default("ទំនាក់ទំនងតាម Telegram")
  featured    Boolean  @default(true)
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
  @@index([featured])
}

